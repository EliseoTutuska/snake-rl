# cp .env.example .env 后按需修改；不要提交 .env

# 国内 ECS 推荐下面这套；能直连官方源可全部删掉用默认值
NODE_IMAGE=docker.1ms.run/library/node:24-bookworm-slim
PYTHON_IMAGE=docker.1ms.run/library/python:3.12-slim
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
TORCH_INDEX_URL=https://mirror.sjtu.edu.cn/pytorch-wheels/cpu

# 端口与监听地址；Tailscale 访问保持 0.0.0.0 即可
SNAKE_PORT=8000
SNAKE_BIND=0.0.0.0
